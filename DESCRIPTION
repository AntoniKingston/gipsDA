Package: gipsDA
Title: Discriminant Analysis with Permutation-Invariant Covariance Models
Version: 0.1.2.9000
Authors@R: c(
    person(c("Antoni", "Zbigniew"), "Kingston", , "qqtrol@gmail.com", role = "aut"),
